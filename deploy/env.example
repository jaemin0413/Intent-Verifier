PUBLIC_ORIGIN=https://tool.example.com
APP_DATA_DIR=/var/lib/figma-intent
PORT=4318
# Folders whose Gradle builds this server may run. Separate several with ":".
BACKEND_ROOTS=/srv/figma-intent/backends
# Operator password: required to save API keys, switch the team AI, or set Notion/Figma connections.
ADMIN_KEY=change-me
# CLI logins and Gradle caches stay in the service account's data directory.
HOME=/var/lib/figma-intent/home
